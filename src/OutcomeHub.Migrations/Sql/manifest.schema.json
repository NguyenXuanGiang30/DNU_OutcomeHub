{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutcomeHub migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "product",
    "postgres_major",
    "minimum_runner_version",
    "advisory_lock_key",
    "migrations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "format_version": { "const": 1 },
    "product": { "const": "OutcomeHub" },
    "postgres_major": { "const": 18 },
    "minimum_runner_version": { "type": "string" },
    "advisory_lock_key": { "type": "integer" },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "id",
          "migration_name",
          "transaction_mode",
          "script",
          "precondition",
          "postcondition",
          "script_checksum",
          "precondition_checksum",
          "postcondition_checksum",
          "timeout_seconds",
          "retry_policy"
        ],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "id": { "type": "string", "format": "uuid" },
          "migration_name": {
            "type": "string",
            "pattern": "^[0-9]{4}_[a-z0-9_]+$"
          },
          "transaction_mode": {
            "enum": ["TRANSACTIONAL", "OPERATIONAL"]
          },
          "script": { "type": "string" },
          "precondition": { "type": "string" },
          "postcondition": { "type": "string" },
          "script_checksum": { "$ref": "#/$defs/checksum" },
          "precondition_checksum": { "$ref": "#/$defs/checksum" },
          "postcondition_checksum": { "$ref": "#/$defs/checksum" },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "retry_policy": { "enum": ["ATOMIC", "IDEMPOTENT"] }
        }
      }
    }
  },
  "$defs": {
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
